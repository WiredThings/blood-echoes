#version 450 core

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_control_flow_attributes : require

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint NUM_SAMPLES = 1;
layout(constant_id = 1) const uint MICRO_TILE_MODE = 1;
layout(constant_id = 2) const uint MICRO_TILE_THICKNESS = 1;
layout(constant_id = 3) const uint IS_TILER = 0;
// Legacy 460-byte parameter blocks must never access this private extension.
layout(constant_id = 13) const bool HAS_LOGICAL_BOUNDS = false;
#if IS_MACRO_TILED
layout(constant_id = 4) const uint ARRAY_MODE = 0;
layout(constant_id = 5) const uint PIPE_CONFIG = 0;
layout(constant_id = 6) const uint BANK_WIDTH = 1;
layout(constant_id = 7) const uint BANK_HEIGHT = 1;
layout(constant_id = 8) const uint NUM_BANKS = 1;
layout(constant_id = 9) const uint NUM_BANK_BITS = 1;
layout(constant_id = 10) const uint TILE_SPLIT_BYTES = 1;
layout(constant_id = 11) const uint MACRO_TILE_ASPECT = 1;
#endif

#define BYTES_PER_PIXEL (BITS_PER_PIXEL / 8)

#if BITS_PER_PIXEL == 8
#define BLOCK_TYPE uint8_t
#elif BITS_PER_PIXEL == 16
#define BLOCK_TYPE uint16_t
#elif BITS_PER_PIXEL == 32
#define BLOCK_TYPE uint32_t
#elif BITS_PER_PIXEL == 64
#define BLOCK_TYPE u32vec2
#elif BITS_PER_PIXEL == 96
#define BLOCK_TYPE u32vec3
#else
#define BLOCK_TYPE u32vec4
#endif

#if IS_MACRO_TILED
const uint NUM_PIPES = PIPE_CONFIG == 0 ? 2 : 8;
const uint NUM_PIPE_BITS = PIPE_CONFIG == 0 ? 1 : 3;
#endif

#define MICRO_TILE_WIDTH 8
#define MICRO_TILE_HEIGHT 8
#define MICRO_TILE_PIXELS (MICRO_TILE_WIDTH * MICRO_TILE_HEIGHT)
#define MICRO_TILE_BITS (MICRO_TILE_PIXELS * MICRO_TILE_THICKNESS * BITS_PER_PIXEL * NUM_SAMPLES)
#define MICRO_TILE_BYTES (MICRO_TILE_BITS / 8)

#define NUM_PIPE_INTERLEAVE_BITS 8

#define ADDR_SURF_DISPLAY_MICRO_TILING 0
#define ADDR_SURF_THIN_MICRO_TILING 1
#define ADDR_SURF_DEPTH_MICRO_TILING 2
#define ADDR_SURF_ROTATED_MICRO_TILING 3

#define ARRAY_LINEAR_GENERAL 0
#define ARRAY_LINEAR_ALIGNED 1
#define ARRAY_1D_TILED_THIN1 2
#define ARRAY_1D_TILED_THICK 3
#define ARRAY_2D_TILED_THIN1 4
#define ARRAY_PRT_TILED_THIN1 5
#define ARRAY_PRT_2D_TILED_THIN1 6
#define ARRAY_2D_TILED_THICK 7
#define ARRAY_2D_TILED_XTHICK 8
#define ARRAY_PRT_TILED_THICK 9
#define ARRAY_PRT_2D_TILED_THICK 10
#define ARRAY_PRT_3D_TILED_THIN1 11
#define ARRAY_3D_TILED_THIN1 12
#define ARRAY_3D_TILED_THICK 13
#define ARRAY_3D_TILED_XTHICK 14
#define ARRAY_PRT_3D_TILED_THICK 15

#define	ADDR_SURF_P2 0
#define	ADDR_SURF_P8_32x32_8x16	10
#define	ADDR_SURF_P8_32x32_16x16 12

#define BITS_PER_BYTE 8
#define BITS_TO_BYTES(x) (((x) + (BITS_PER_BYTE-1)) / BITS_PER_BYTE)

#define _BIT(v, b) bitfieldExtract((v), (b), 1)

// A mip (TilingMip in texture_cache/tile_manager.h): the linear image of the mip is `slices`
// slices of height rows of pitch texels (the logical size, what the linear copies of the texture
// cache hold), the tiled surface is laid out padded (padded_height rows of padded_pitch texels,
// multiples of the macro tile's size) and has size bytes. Only the logical texels are copied.
struct MipInfo {
    uint size;
    uint pitch;
    uint height;
    uint offset;
    uint padded_pitch;
    uint padded_height;
    uint slices;
};

layout (set = 0, binding = 0, scalar) buffer InputBuf {
    BLOCK_TYPE tiled_data[];
};

layout (set = 0, binding = 1, scalar) buffer OutputBuf {
    BLOCK_TYPE linear_data[];
};

struct LogicalMipBounds { uint width; uint height; uint slices; };

layout (set = 0, binding = 2, scalar) uniform TilingInfo {
    uint bank_swizzle;
    uint micro_tiled_mips;
    uint num_mips;
    MipInfo mips[16];
    LogicalMipBounds logical[16];
} info;

uint32_t ComputePixelIndexWithinMicroTile(uint32_t x, uint32_t y, uint32_t z, uint32_t thickness) {
    uint32_t p0 = 0;
    uint32_t p1 = 0;
    uint32_t p2 = 0;
    uint32_t p3 = 0;
    uint32_t p4 = 0;
    uint32_t p5 = 0;
    uint32_t p6 = 0;
    uint32_t p7 = 0;
    uint32_t p8 = 0;

    uint32_t x0 = _BIT(x, 0);
    uint32_t x1 = _BIT(x, 1);
    uint32_t x2 = _BIT(x, 2);
    uint32_t y0 = _BIT(y, 0);
    uint32_t y1 = _BIT(y, 1);
    uint32_t y2 = _BIT(y, 2);
    uint32_t z0 = _BIT(z, 0);
    uint32_t z1 = _BIT(z, 1);
    uint32_t z2 = _BIT(z, 2);

    if (MICRO_TILE_MODE == ADDR_SURF_DISPLAY_MICRO_TILING) {
#if BITS_PER_PIXEL == 8
        p0 = x0;
        p1 = x1;
        p2 = x2;
        p3 = y1;
        p4 = y0;
        p5 = y2;
#elif BITS_PER_PIXEL == 16
        p0 = x0;
        p1 = x1;
        p2 = x2;
        p3 = y0;
        p4 = y1;
        p5 = y2;
#elif BITS_PER_PIXEL == 32
        p0 = x0;
        p1 = x1;
        p2 = y0;
        p3 = x2;
        p4 = y1;
        p5 = y2;
#elif BITS_PER_PIXEL == 64
        p0 = x0;
        p1 = y0;
        p2 = x1;
        p3 = x2;
        p4 = y1;
        p5 = y2;
#elif BITS_PER_PIXEL == 128
        p0 = x0;
        p1 = y0;
        p2 = x1;
        p3 = y1;
        p4 = x2;
        p5 = y2;
#endif
    } else if (MICRO_TILE_MODE == ADDR_SURF_THIN_MICRO_TILING ||
        MICRO_TILE_MODE == ADDR_SURF_DEPTH_MICRO_TILING) {
        p0 = x0;
        p1 = y0;
        p2 = x1;
        p3 = y1;
        p4 = x2;
        p5 = y2;
    } else {
#if BITS_PER_PIXEL == 8 || BITS_PER_PIXEL == 16
        p0 = x0;
        p1 = y0;
        p2 = x1;
        p3 = y1;
        p4 = z0;
        p5 = z1;
#elif BITS_PER_PIXEL == 32
        p0 = x0;
        p1 = y0;
        p2 = x1;
        p3 = z0;
        p4 = y1;
        p5 = z1;
#elif BITS_PER_PIXEL == 64 || BITS_PER_PIXEL == 128
        p0 = x0;
        p1 = y0;
        p2 = z0;
        p3 = x1;
        p4 = y1;
        p5 = z1;
#endif
        p6 = x2;
        p7 = y2;

        if (thickness == 8) {
            p8 = z2;
        }
    }

    uint32_t pixel_number =
        ((p0) | (p1 << 1) | (p2 << 2) | (p3 << 3) | (p4 << 4) |
         (p5 << 5) | (p6 << 6) | (p7 << 7) | (p8 << 8));

    return pixel_number;
}


// How the kernel is organised (the address of every texel is the one of the GCN addressing
// library; this file only changes how the work is spread over threads):
//
// - The linear buffer holds the texels of all mips one after the other (info.mips[].size bytes
//   each); the texel of a mip is x + y * pitch + slice * pitch * height, for the info.mips[].slices
//   slices of the logical size (pitch x height). The tiled surface of the mip is padded: its
//   slices are padded_pitch x padded_height texels (multiples of the macro tile's size), and the
//   address of a texel is the one in that padded surface. The padding is not image data: no texel
//   of it is read or written, and no byte outside the mip's size is touched (the host gives the
//   number of whole padded slices in the size as `slices`).
// - A unit is 64 texels (the units of a mip are counted from its size, the logical texels are
//   fewer or as many: the later units end at once). A mip whose logical pitch and height are
//   multiples of 8 is cut into micro tiles of 8x8 texels of one slice, one unit each, in the
//   order of the tiles in the linear image. Any other mip is cut into 64 consecutive linear
//   texels, and its texels are divided into x, y and slice one by one.
// - A thread handles one row of 8 texels of one unit, eight threads a unit, so a workgroup of 64
//   threads handles 8 units. A row is in one micro tile: everything of the address that depends
//   on the tile only (the macro tile, pipe, bank) is computed once per row, and the 8 texels add
//   their position in the micro tile (a few bit operations of constants). The eight threads of a
//   micro tile write (tiler) or read (detiler) its bytes together.
// The host dispatches ceil(units / 8) workgroups (TileManager::MakeDispatch).
#define TEXELS_PER_THREAD 8
#define THREADS_PER_UNIT 8
#define TEXELS_PER_UNIT 64

// Bytes of the micro tile per step of the pixel index (the sample is always the first).
const uint PIXEL_INDEX_BYTES = MICRO_TILE_MODE == ADDR_SURF_DEPTH_MICRO_TILING
                                   ? BYTES_PER_PIXEL * NUM_SAMPLES
                                   : BYTES_PER_PIXEL;

// The position of the texels of a row in the micro tile: x (the texel in the row) only in its
// own bits of the pixel index, y and z in theirs, so the two parts are ORed.
uint PixelIndexX(uint x, uint thickness) {
    return ComputePixelIndexWithinMicroTile(x, 0, 0, thickness);
}

uint PixelIndexYZ(uint y, uint z, uint thickness) {
    return ComputePixelIndexWithinMicroTile(0, y, z, thickness);
}

// One row of texels of a micro tile (micro tiled mip): what of the address does not depend on the
// texel of the row, set up once. MicroAddress adds the texel.
struct MicroRow {
    uint base;  // byte offset of the micro tile in the mip
    uint yz;    // pixel index of the row's y and z
    uint tiled; // byte offset of the mip in the tiled buffer
};

MicroRow MakeMicroRow(uint x, uint y, uint slice, uint pitch, uint height, uint thickness,
                      uint mip_offset) {
    uint micro_tile_bytes = MICRO_TILE_PIXELS * thickness * BITS_PER_PIXEL * NUM_SAMPLES / 8;
    uint slice_bytes = BITS_TO_BYTES(pitch * height * thickness * BITS_PER_PIXEL * NUM_SAMPLES);

    uint micro_tiles_per_row = pitch / MICRO_TILE_WIDTH;
    uint micro_tile_index_x = x / MICRO_TILE_WIDTH;
    uint micro_tile_index_y = y / MICRO_TILE_HEIGHT;
    uint micro_tile_index_z = slice / thickness;

    uint slice_offset = micro_tile_index_z * slice_bytes;
    uint micro_tile_offset =
        (micro_tile_index_y * micro_tiles_per_row + micro_tile_index_x) * micro_tile_bytes;

    MicroRow row;
    row.base = slice_offset + micro_tile_offset;
    row.yz = PixelIndexYZ(y, slice, thickness);
    row.tiled = mip_offset;
    return row;
}

uint MicroAddress(MicroRow row, uint pixel_index_x) {
    return row.tiled + row.base + (pixel_index_x | row.yz) * PIXEL_INDEX_BYTES;
}

#if IS_MACRO_TILED
uint ComputePipeFromCoord(uint x, uint y, uint slice) {
    uint p0 = 0;
    uint p1 = 0;
    uint p2 = 0;

    uint tx = x / MICRO_TILE_WIDTH;
    uint ty = y / MICRO_TILE_HEIGHT;
    uint x3 = _BIT(tx, 0);
    uint x4 = _BIT(tx, 1);
    uint x5 = _BIT(tx, 2);
    uint y3 = _BIT(ty, 0);
    uint y4 = _BIT(ty, 1);
    uint y5 = _BIT(ty, 2);

    if (PIPE_CONFIG == ADDR_SURF_P2) {
        p0 = x3 ^ y3;
    } else if (PIPE_CONFIG == ADDR_SURF_P8_32x32_8x16) {
        p0 = x4 ^ y3 ^ x5;
        p1 = x3 ^ y4;
        p2 = x5 ^ y5;
    } else if (PIPE_CONFIG == ADDR_SURF_P8_32x32_16x16) {
        p0 = x3 ^ y3 ^ x4;
        p1 = x4 ^ y4;
        p2 = x5 ^ y5;
    }

    uint pipe = p0 | (p1 << 1) | (p2 << 2);

    uint pipe_swizzle = 0;
    if (ARRAY_MODE == ARRAY_3D_TILED_THIN1 || ARRAY_MODE == ARRAY_3D_TILED_THICK ||
        ARRAY_MODE == ARRAY_3D_TILED_XTHICK) {
        pipe_swizzle += max(1u, NUM_PIPES / 2 - 1) * (slice / MICRO_TILE_THICKNESS);
    }
    pipe_swizzle &= (NUM_PIPES - 1);
    pipe = pipe ^ pipe_swizzle;
    return pipe;
}

// The bank of a micro tile before the tile split of the texel is mixed in and the bank mask applied.
uint ComputeBankFromCoord(uint x, uint y, uint slice) {
    uint b0 = 0;
    uint b1 = 0;
    uint b2 = 0;
    uint b3 = 0;
    uint slice_rotation = 0;

    uint tx = x / MICRO_TILE_WIDTH / (BANK_WIDTH * NUM_PIPES);
    uint ty = y / MICRO_TILE_HEIGHT / BANK_HEIGHT;

    uint x3 = _BIT(tx, 0);
    uint x4 = _BIT(tx, 1);
    uint x5 = _BIT(tx, 2);
    uint x6 = _BIT(tx, 3);
    uint y3 = _BIT(ty, 0);
    uint y4 = _BIT(ty, 1);
    uint y5 = _BIT(ty, 2);
    uint y6 = _BIT(ty, 3);

    if (NUM_BANKS == 16) {
        b0 = x3 ^ y6;
        b1 = x4 ^ y5 ^ y6;
        b2 = x5 ^ y4;
        b3 = x6 ^ y3;
    } else if (NUM_BANKS == 8) {
        b0 = x3 ^ y5;
        b1 = x4 ^ y4 ^ y5;
        b2 = x5 ^ y3;
    } else if (NUM_BANKS == 4) {
        b0 = x3 ^ y4;
        b1 = x4 ^ y3;
    } else if (NUM_BANKS == 2) {
        b0 = x3 ^ y3;
    }

    uint bank = b0 | (b1 << 1) | (b2 << 2) | (b3 << 3);

    if (ARRAY_MODE == ARRAY_2D_TILED_THIN1 || ARRAY_MODE == ARRAY_2D_TILED_THICK ||
        ARRAY_MODE == ARRAY_2D_TILED_XTHICK) {
        slice_rotation = ((NUM_BANKS / 2) - 1) * (slice / MICRO_TILE_THICKNESS);
    } else if (ARRAY_MODE == ARRAY_3D_TILED_THIN1 || ARRAY_MODE == ARRAY_3D_TILED_THICK ||
        ARRAY_MODE == ARRAY_3D_TILED_XTHICK) {
        slice_rotation = max(1u, (NUM_PIPES / 2) - 1) * (slice / MICRO_TILE_THICKNESS) / NUM_PIPES;
    }

    return bank ^ (info.bank_swizzle + slice_rotation);
}

// Is a micro tile split in several tile split slices (tile_split_slice of the texel is its
// position divided by the tile split)?
const bool TILE_SPLIT_USED = MICRO_TILE_BYTES > TILE_SPLIT_BYTES && MICRO_TILE_THICKNESS == 1;
const uint SLICES_PER_TILE = TILE_SPLIT_USED ? MICRO_TILE_BYTES / TILE_SPLIT_BYTES : 1;
const uint TILE_BYTES = TILE_SPLIT_USED ? TILE_SPLIT_BYTES : MICRO_TILE_BYTES;
const bool TILE_SPLIT_ROTATES =
    ARRAY_MODE == ARRAY_2D_TILED_THIN1 || ARRAY_MODE == ARRAY_3D_TILED_THIN1 ||
    ARRAY_MODE == ARRAY_PRT_2D_TILED_THIN1 || ARRAY_MODE == ARRAY_PRT_3D_TILED_THIN1;
const bool IS_PRT =
    ARRAY_MODE == ARRAY_PRT_TILED_THIN1 || ARRAY_MODE == ARRAY_PRT_TILED_THICK ||
    ARRAY_MODE == ARRAY_PRT_2D_TILED_THIN1 || ARRAY_MODE == ARRAY_PRT_2D_TILED_THICK ||
    ARRAY_MODE == ARRAY_PRT_3D_TILED_THIN1 || ARRAY_MODE == ARRAY_PRT_3D_TILED_THICK;

const uint MACRO_TILE_PITCH = (MICRO_TILE_WIDTH * BANK_WIDTH * NUM_PIPES) * MACRO_TILE_ASPECT;
const uint MACRO_TILE_HEIGHT = (MICRO_TILE_HEIGHT * BANK_HEIGHT * NUM_BANKS) / MACRO_TILE_ASPECT;
const uint MACRO_TILE_BYTES = TILE_BYTES * (MACRO_TILE_PITCH / MICRO_TILE_WIDTH) *
                              (MACRO_TILE_HEIGHT / MICRO_TILE_HEIGHT) / (NUM_PIPES * NUM_BANKS);

// The same for a macro tiled mip (MacroAddress adds the texel).
struct MacroRow {
    uint base;        // what of the byte offset does not depend on the texel or its tile split slice
    uint slice_bytes; // bytes of a tile split slice of the image: a split texel is this much further
    uint yz;
    uint bank;        // the bank before the tile split of the texel is mixed in
    uint pipe;
    uint tiled;       // byte offset of the mip in the tiled buffer
};

MacroRow MakeMacroRow(uint x, uint y, uint slice, uint pitch, uint height, uint mip_offset) {
    uint macro_tiles_per_row = pitch / MACRO_TILE_PITCH;

    uint macro_tile_index_x = x / MACRO_TILE_PITCH;
    uint macro_tile_index_y = y / MACRO_TILE_HEIGHT;
    uint macro_tile_offset =
        ((macro_tile_index_y * macro_tiles_per_row) + macro_tile_index_x) * MACRO_TILE_BYTES;
    uint macro_tiles_per_slice = macro_tiles_per_row * (height / MACRO_TILE_HEIGHT);

    uint slice_bytes = macro_tiles_per_slice * MACRO_TILE_BYTES;
    uint slice_offset = slice_bytes * (SLICES_PER_TILE * (slice / MICRO_TILE_THICKNESS));

    uint tile_row_index = (y / MICRO_TILE_HEIGHT) % BANK_HEIGHT;
    uint tile_column_index = ((x / MICRO_TILE_WIDTH) / NUM_PIPES) % BANK_WIDTH;
    uint tile_index = (tile_row_index * BANK_WIDTH) + tile_column_index;
    uint tile_offset = tile_index * TILE_BYTES;

    MacroRow row;
    row.yz = PixelIndexYZ(y, slice, MICRO_TILE_THICKNESS);

    if (IS_PRT) {
        x %= MACRO_TILE_PITCH;
        y %= MACRO_TILE_HEIGHT;
    }

    row.base = slice_offset + macro_tile_offset + tile_offset;
    row.slice_bytes = slice_bytes;
    row.tiled = mip_offset;
    row.bank = ComputeBankFromCoord(x, y, slice);
    row.pipe = ComputePipeFromCoord(x, y, slice);
    return row;
}

uint MacroAddress(MacroRow row, uint pixel_index_x) {
    uint element_offset = (pixel_index_x | row.yz) * PIXEL_INDEX_BYTES;

    uint tile_split_slice = 0;
    if (TILE_SPLIT_USED) {
        tile_split_slice = element_offset / TILE_SPLIT_BYTES;
        element_offset %= TILE_SPLIT_BYTES;
    }

    uint total_offset = row.base + element_offset + row.slice_bytes * tile_split_slice;

    uint bank = row.bank;
    if (TILE_SPLIT_ROTATES) {
        bank ^= ((NUM_BANKS / 2) + 1) * tile_split_slice;
    }
    bank &= (NUM_BANKS - 1);

    uint pipe_interleave_mask = (1 << NUM_PIPE_INTERLEAVE_BITS) - 1;
    uint pipe_interleave_offset = total_offset & pipe_interleave_mask;
    uint offset = total_offset >> NUM_PIPE_INTERLEAVE_BITS;

    uint addr = pipe_interleave_offset;
    uint pipe_bits = row.pipe << NUM_PIPE_INTERLEAVE_BITS;
    uint bank_bits = bank << (NUM_PIPE_INTERLEAVE_BITS + NUM_PIPE_BITS);
    uint offset_bits = offset << (NUM_PIPE_INTERLEAVE_BITS + NUM_PIPE_BITS + NUM_BANK_BITS);

    addr |= pipe_bits;
    addr |= bank_bits;
    addr |= offset_bits;

    return row.tiled + addr;
}
#endif

void Copy(uint linear_index, uint tiled_offset) {
    if (IS_TILER != 0) {
        tiled_data[tiled_offset / BYTES_PER_PIXEL] = linear_data[linear_index];
    } else {
        linear_data[linear_index] = tiled_data[tiled_offset / BYTES_PER_PIXEL];
    }
}

// The texels of a whole row: all of them are read before the first is written (the compiler
// cannot know that the two buffers do not overlap, and would otherwise wait for every texel's
// read before it starts the next).
void CopyWholeRow(uint linear_index, uint tiled_offsets[TEXELS_PER_THREAD]) {
    BLOCK_TYPE texels[TEXELS_PER_THREAD];
    [[unroll]] for (uint i = 0; i < TEXELS_PER_THREAD; ++i) {
        if (IS_TILER != 0) {
            texels[i] = linear_data[linear_index + i];
        } else {
            texels[i] = tiled_data[tiled_offsets[i] / BYTES_PER_PIXEL];
        }
    }
    [[unroll]] for (uint i = 0; i < TEXELS_PER_THREAD; ++i) {
        if (IS_TILER != 0) {
            tiled_data[tiled_offsets[i] / BYTES_PER_PIXEL] = texels[i];
        } else {
            linear_data[linear_index + i] = texels[i];
        }
    }
}

// Copies count texels of row y from texel x on (not past the end of the micro tile row), the
// ones of the linear buffer from linear_index on.
void CopyRow(uint mip, uint x, uint y, uint slice, uint pitch, uint height, uint linear_index,
             uint count) {
    uint mip_offset = info.mips[mip].offset;
    bool whole_row = count == TEXELS_PER_THREAD && (x & (TEXELS_PER_THREAD - 1)) == 0;
    uint tiled_offsets[TEXELS_PER_THREAD];
#if IS_MACRO_TILED
    if ((info.micro_tiled_mips & (1u << mip)) == 0) {
        MacroRow row = MakeMacroRow(x, y, slice, pitch, height, mip_offset);
        if (whole_row) {
            [[unroll]] for (uint i = 0; i < TEXELS_PER_THREAD; ++i) {
                tiled_offsets[i] = MacroAddress(row, PixelIndexX(i, MICRO_TILE_THICKNESS));
            }
            CopyWholeRow(linear_index, tiled_offsets);
        } else {
            for (uint i = 0; i < count; ++i) {
                Copy(linear_index + i, MacroAddress(row, PixelIndexX(x + i, MICRO_TILE_THICKNESS)));
            }
        }
        return;
    }
    const uint thickness = min(MICRO_TILE_THICKNESS, 4u);
#else
    const uint thickness = MICRO_TILE_THICKNESS;
#endif
    MicroRow row = MakeMicroRow(x, y, slice, pitch, height, thickness, mip_offset);
    if (whole_row) {
        [[unroll]] for (uint i = 0; i < TEXELS_PER_THREAD; ++i) {
            tiled_offsets[i] = MicroAddress(row, PixelIndexX(i, thickness));
        }
        CopyWholeRow(linear_index, tiled_offsets);
    } else {
        for (uint i = 0; i < count; ++i) {
            Copy(linear_index + i, MicroAddress(row, PixelIndexX(x + i, thickness)));
        }
    }
}

void main() {
    uint unit = gl_GlobalInvocationID.x / THREADS_PER_UNIT;
    uint thread_in_unit = gl_GlobalInvocationID.x % THREADS_PER_UNIT;

    // The mip of the unit, the first texel of the mip in the linear buffer and its texel count.
    uint mip = 0;
    uint mip_first_texel = 0;
    uint mip_texels = 0;
    while (mip < info.num_mips) {
        mip_texels = info.mips[mip].size / BYTES_PER_PIXEL;
        uint mip_units = (mip_texels + TEXELS_PER_UNIT - 1) / TEXELS_PER_UNIT;
        if (unit < mip_units) {
            break;
        }
        unit -= mip_units;
        mip_first_texel += mip_texels;
        ++mip;
    }
    if (mip >= info.num_mips) {
        return;
    }
    // The logical image of the mip: slices of height rows of pitch texels, the linear texels. The
    // tiled surface is laid out in the padded size (padded_pitch, padded_height), the texels of
    // the padding are not copied.
    uint pitch = info.mips[mip].pitch;
    uint height = info.mips[mip].height;
    uint padded_pitch = info.mips[mip].padded_pitch;
    uint padded_height = info.mips[mip].padded_height;
    uint slices = info.mips[mip].slices;
    uint slice_texels = pitch * height;
    uint image_texels = slice_texels * slices;
    if (image_texels == 0) {
        return;
    }

    // A mip of whole micro tiles in the linear image: the units are the micro tiles of the image.
    // (The common mip of one slice needs no division.)
    bool one_slice = slices == 1;
    bool tiles = (pitch & (MICRO_TILE_WIDTH - 1)) == 0 && (height & (MICRO_TILE_HEIGHT - 1)) == 0;
    uint tiles_per_row = pitch / MICRO_TILE_WIDTH;
    uint tiles_per_slice = tiles_per_row * (height / MICRO_TILE_HEIGHT);
    // Otherwise the texels of the unit in the order of the linear image, one by one.
    uint texel = unit * TEXELS_PER_UNIT + thread_in_unit * TEXELS_PER_THREAD;
    uint end = tiles ? 1 : min(texel + TEXELS_PER_THREAD, image_texels);
    if (tiles) {
        if (unit >= tiles_per_slice * slices) {
            return;
        }
        texel = 0;
    }
    while (texel < end) {
        uint x, y, slice, count, linear_index;
        if (tiles) {
            slice = one_slice ? 0 : unit / tiles_per_slice;
            uint tile_in_slice = unit - slice * tiles_per_slice;
            uint tile_y = tile_in_slice / tiles_per_row;
            uint tile_x = tile_in_slice - tile_y * tiles_per_row;
            y = tile_y * MICRO_TILE_HEIGHT + thread_in_unit;
            x = tile_x * MICRO_TILE_WIDTH;
            count = TEXELS_PER_THREAD;
            linear_index = mip_first_texel + (slice * height + y) * pitch + x;
            texel = end;
        } else {
            x = texel % pitch;
            y = (texel / pitch) % height;
            slice = texel / slice_texels;
            // not past the row, the micro tile or the texels of the thread
            count = min(min(end - texel, pitch - x), TEXELS_PER_THREAD - (x & (TEXELS_PER_THREAD - 1)));
            linear_index = mip_first_texel + texel;
            texel += count;
        }
        if (IS_TILER != 0 && HAS_LOGICAL_BOUNDS) {
            // Preserve the physical strides and address calculation. A texture-to-buffer
            // copy initializes only actual image texels, not padded rows or small-mip tails.
            if (x >= info.logical[mip].width || y >= info.logical[mip].height ||
                slice >= info.logical[mip].slices) continue;
            count = min(count, info.logical[mip].width - x);
        }
        CopyRow(mip, x, y, slice, padded_pitch, padded_height, linear_index, count);
    }
}
